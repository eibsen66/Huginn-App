+#if CONFIG_IDF_TARGET_ESP32S3
+/* The AES/SHA hardware lock is held by every caller across this whole
+ * output-only bounce operation, including its final copy and error cleanup.
+ * Internal DMA storage avoids a per-operation heap allocation/fragmentation.
+ * Other targets and input-bounce paths retain their original allocation. */
+static DMA_ATTR __attribute__((aligned(16))) unsigned char s_s3_output_bounce[512];
+_Static_assert(sizeof(s_s3_output_bounce) % AES_BLOCK_BYTES == 0, "AES block size");
+#endif
+
 /* Input over this length will yield and wait for interrupt instead of
    busy-waiting, 30000 bytes is approx 0.5 ms */
 #define AES_DMA_INTR_TRIG_LEN 2000
@@ -244,18 +253,14 @@ static int esp_aes_process_dma_ext_ram(esp_aes_context *ctx, const unsigned char
     uint32_t output_heap_caps = MALLOC_CAP_DMA;
     unsigned char *input_buf = NULL;
     unsigned char *output_buf = NULL;
+    bool output_buf_heap_owned = false;
     const unsigned char *dma_input;
     size_t chunk_limit = AES_MAX_CHUNK_WRITE_SIZE;
 #if CONFIG_IDF_TARGET_ESP32S3
-    /* The S3 can read DMA-capable PSRAM directly, but unaligned external

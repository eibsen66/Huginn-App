-     * below the observed 736-byte largest DMA block, leaving space for
-     * the DMA descriptors and allocator overhead. No persistent reserve
-     * or allocation retry: ordinary allocation failures still propagate.
-     * A whole AES block multiple preserves mode/stream state across chunks.
-     */
+    /* Use the reserved output scratch only on the existing S3 output-only
+     * path. Whole AES blocks preserve stream/mode state across chunks. */
     if (realloc_output && !realloc_input) {
-        chunk_limit = 512;
+        chunk_limit = sizeof(s_s3_output_bounce);
     }
 #endif
     chunk_len = MIN(chunk_limit, len);
@@ -289,19 +294,29 @@ static int esp_aes_process_dma_ext_ram(esp_aes_context *ctx, const unsigned char
     }
 
     if (realloc_output) {
-        /* Normal request context, never an allocator callback. No policy change. */
-        huginn_aes_output_probe_constraints(input, output);
-        huginn_aes_output_probe_before(len, chunk_len, output_alignment, output_heap_caps,
-                                       realloc_input, input == output,
-                                       esp_ptr_external_ram(input), esp_ptr_external_ram(output));
-        output_buf = heap_caps_aligned_alloc(output_alignment, chunk_len, output_heap_caps);
-        huginn_aes_output_probe_after(output_buf == NULL);
-        if (output_buf == NULL) {
-            huginn_aes_alloc_diag_failure(chunk_len, output_heap_caps, "bounce_output", __func__, __LINE__);
-            mbedtls_platform_zeroize(output, len);
-            ESP_LOGE(TAG, "Failed to allocate memory");
-            ret = -1;
-            goto cleanup;
+#if CONFIG_IDF_TARGET_ESP32S3
+        if (!realloc_input) {
+            output_buf = s_s3_output_bounce;
+            assert(esp_ptr_dma_capable(output_buf));
+            assert(((uintptr_t)output_buf & 15) == 0);
+        } else
+#endif
+        {
+            /* Normal request context, never an allocator callback. */
+            huginn_aes_output_probe_constraints(input, output);
+            huginn_aes_output_probe_before(len, chunk_len, output_alignment, output_heap_caps,
+                                           realloc_input, input == output,
+                                           esp_ptr_external_ram(input), esp_ptr_external_ram(output));
+            output_buf = heap_caps_aligned_alloc(output_alignment, chunk_len, output_heap_caps);
+            output_buf_heap_owned = output_buf != NULL;
+            huginn_aes_output_probe_after(output_buf == NULL);
+            if (output_buf == NULL) {
+                huginn_aes_alloc_diag_failure(chunk_len, output_heap_caps, "bounce_output", __func__, __LINE__);
